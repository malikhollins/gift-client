@using Microsoft.FluentUI.AspNetCore.Components
<div class="bottomNav">

    <div class="backToHomepage">
        @if (GoBackUrl != null && GoBackUrl.Any())
        {
            <a class="backbutton" href="@GoBackUrl">
                <Icon CustomIconName="fa-solid fa-arrow-left" Size="BlazorBootstrap.IconSize.x5" />
            </a>
        }
    </div> <!-- hide when not needed? -->

    <div class="plusCreateHouse">
        <CascadingValue Value="@ListId" Name="ListId">
            <CascadingValue Value="@HouseId" Name="HouseId">
                <UniversalModal ModalParameters="CenterModalParameters">
                    <Icon CustomIconName="fa-solid fa-plus" Size="BlazorBootstrap.IconSize.x5" />
                </UniversalModal>
            </CascadingValue>
        </CascadingValue>
    </div> <!-- end plusCreateHouse -->

    <div class="profileButton">
        @if (!RemoveProfileIcon)
        {
            <a href="/profile">
                <FluentCounterBadge VerticalPosition="100" HorizontalPosition="100" BackgroundColor="@Color.Error" Color="Color.Fill" Dot="@HasInvites">
                    <Icon CustomIconName="fa-regular fa-circle-user" Size="BlazorBootstrap.IconSize.x5" />
                </FluentCounterBadge>
            </a>
        }
    </div> <!-- 1end profileButton -->

</div> <!-- end bottom nav -->