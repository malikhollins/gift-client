@using Microsoft.FluentUI.AspNetCore.Components
<div class="bottomNav">
    <div class="backToHomepage">
        <button type="button"
                class="bottom-nav-button @(CurrentPage == NavPage.Home ? "active" : null)"
                aria-label="Home"
                aria-current="@(CurrentPage == NavPage.Home ? "page" : null)"
                disabled="@(CurrentPage == NavPage.Home)"
                @onclick="NavigateHome">
            <Icon CustomIconName="fa-solid fa-house" Size="BlazorBootstrap.IconSize.x5" />
        </button>
    </div> <!-- hide when not needed? -->

    <div class="plusCreateHouse">
        @if (CenterModalParameters is { } modalParameters)
        {
            <CascadingValue Value="@ListId" Name="ListId">
                <CascadingValue Value="@HouseId" Name="HouseId">
                    <UniversalModal ModalParameters="modalParameters">
                        <button type="button" class="bottom-nav-button" aria-label="Create">
                            <Icon CustomIconName="fa-solid fa-plus" Size="BlazorBootstrap.IconSize.x5" />
                        </button>
                    </UniversalModal>
                </CascadingValue>
            </CascadingValue>
        }
        else
        {
            <button type="button" class="bottom-nav-button" aria-label="Create" disabled>
                <Icon CustomIconName="fa-solid fa-plus" Size="BlazorBootstrap.IconSize.x5" />
            </button>
        }
    </div> <!-- end plusCreateHouse -->

    <div class="profileButton">
        <button type="button"
                class="bottom-nav-button @(CurrentPage == NavPage.Profile ? "active" : null)"
                aria-label="@(HasInvites ? "Profile, pending invites" : "Profile")"
                aria-current="@(CurrentPage == NavPage.Profile ? "page" : null)"
                disabled="@(CurrentPage == NavPage.Profile)"
                @onclick="NavigateToProfile">
            <span class="profile-icon">
                <Icon CustomIconName="fa-regular fa-circle-user" Size="BlazorBootstrap.IconSize.x5" />
                @if (HasInvites)
                {
                    <span class="profile-invite-dot" aria-hidden="true"></span>
                }
            </span>
        </button>
    </div> <!-- 1end profileButton -->
</div> <!-- end bottom nav -->