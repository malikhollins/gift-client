
<div class="invites">
    
    <span> Invites </span>

    @if (Invites.Any())
    {
        <SortableList AllowSorting="false" Context="item" Data="@Invites" TItem="UserInvites">
            <ItemTemplate>
                <InviteCard Model="@item" />
            </ItemTemplate>
        </SortableList>
    }
    else
    {
        <div class="no-invites">
            <span class="text-italic"> No invites yet </span>
        </div>
    }
</div>
