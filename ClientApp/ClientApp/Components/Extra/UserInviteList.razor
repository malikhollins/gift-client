
<div class="invites">
    
    <h4>invites</h4>

        <div class="house-memberships">
            <h5>Pending invites</h5>
            <SortableList AllowSorting="false" Context="item" Data="@PendingInvites" TItem="UserInvites">
                <ItemTemplate>
                    <InviteCard Model="@item" />
                </ItemTemplate>
               <EmptyDataTemplate>
                    <p class="text-italic">No pending invites.</p>
               </EmptyDataTemplate>
            </SortableList>
        </div>

        <div class="house-memberships">
            <h5>House memberships</h5>
            <p class="membership-warning">Leaving a house deletes the lists and items you had in it.</p>
                @foreach (var invite in AcceptedInvites)
                {
                    <div class="house-membership">
                        <span>@invite.House?.Name</span>
                        <Button Class="leave-house-button" @onclick="() => ConfirmLeaveHouseAsync(invite)">
                            Leave house
                        </Button>
                    </div>
                }
                @if ( !AcceptedInvites.Any())
                {
                    <p class="text-italic">No house memberships.</p>
                } 
        </div>

    <UniversalModal @ref="_leaveHouseModal" ModalParameters="_leaveHouseParameters" />
</div>
